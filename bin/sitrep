#!/bin/bash
# sitrep: per-session work queues for Claude Code sessions. Sessions are addressed by a unique id prefix (shown in the status line and `sitrep ls`).
umask 077
dir="$HOME/.claude/sitrep"
die() { echo "sitrep: $*" >&2; exit 1; }
# Text is untrusted terminal input: drop control (Cc, incl. C1) and format (Cf, incl. bidi) characters.
clean() { perl -CSD -0777 -pe 's/[\n\t\p{Zl}\p{Zp}]/ /g; s/[\p{Cc}\p{Cf}]//g; s/ +$//; $_=substr($_,0,200)' 2>/dev/null; }   # for text being stored: one flat line
fit() { N=$1 perl -CSD -pe 'chomp; $_ = (length > $ENV{N} ? substr($_, 0, $ENV{N} - 1) . "\x{2026}" : $_) . "\n"' 2>/dev/null; }   # cut to N characters with an ellipsis
strip() { perl -CSD -pe 's/(?!\n|\t)[\p{Cc}\p{Cf}]//g' 2>/dev/null; }                                                   # for text being shown: keeps line breaks
mtime() { stat -c %Y "$1" 2>/dev/null || stat -f %m "$1" 2>/dev/null; }
tmpfile() { mktemp "$dir/.sitrep.XXXXXX"; }
itemno() { [[ $1 =~ ^[1-9][0-9]*$ ]] || die "item must be a number"; }
cwd_of() { clean 2>/dev/null < "$dir/$1.cwd"; }

resolve() { # prefix -> full session id; `inbox` is the queue of no session and matches exactly
  [[ $1 =~ ^[A-Za-z0-9_-]+$ ]] || die "bad id '$1'"
  [ "$1" = inbox ] && { echo inbox; return; }
  local m=() f
  for f in "$dir"/"$1"*.txt; do [ -f "$f" ] && m+=("$(basename "$f" .txt)"); done
  [ ${#m[@]} -eq 1 ] || die "id '$1' matches ${#m[@]}; run 'sitrep ls'"
  echo "${m[0]}"
}
qf() { echo "$dir/$1.queue"; }
count() { local n; n=$(grep -c . "$(qf "$1")" 2>/dev/null); echo "${n:-0}"; }
label() { if [ "$1" = inbox ]; then echo inbox; else echo "${1:0:4}"; fi; }
qsum() { # id: "empty", "1 item" or "N items", plus the next item
  local n q; n=$(count "$1")
  case "$n" in 0) q="empty" ;; 1) q="1 item" ;; *) q="$n items" ;; esac
  [ "$n" -gt 0 ] && q="$q, next: $(head -n 1 "$(qf "$1")" | strip)"
  echo "$q"
}
without() { # file n text: print a temp file holding the queue minus line n; fails if line n is no longer text
  local t; t=$(tmpfile) || return 1
  if E=$3 awk -v n="$2" '{ if (NR == n) { if ($0 != ENVIRON["E"]) bad = 1; else next } print } END { exit bad }' "$1" > "$t"; then echo "$t"; else rm -f "$t"; return 1; fi
}

reorder_q() { # id from to: move item `from` to position `to`
  local sid=$1 from=$2 to=$3 f n item t
  itemno "$from"; itemno "$to"
  f=$(qf "$sid"); n=$(count "$sid")
  [ "$from" -le "$n" ] && [ "$to" -le "$n" ] || die "$(label "$sid") has $n items"
  item=$(sed -n "${from}p" "$f"); t=$(tmpfile) || exit 1
  if E=$item awk -v f="$from" -v t="$to" '{ a[NR] = $0 }
      END { if (a[f] != ENVIRON["E"]) exit 1
            for (i = 1; i <= NR; i++) if (i != f) c[++k] = a[i]
            for (i = 1; i < t; i++) print c[i]
            print a[f]
            for (i = t; i <= k; i++) print c[i] }' "$f" > "$t"; then
    mv "$t" "$f" || { rm -f "$t"; die "could not update $(label "$sid")"; }
    echo "item $to on $(label "$sid"): $(printf '%s' "$item" | strip)"
  else rm -f "$t"; die "queue changed; run 'sitrep ls $(label "$sid")'"; fi
}

cmd=${1:-ls}; [ $# -gt 0 ] && shift
case "$cmd" in
  ls)
    if [ -n "$1" ]; then
      sid=$(resolve "$1") || exit 1; f=$(qf "$sid")
      if [ "$sid" = inbox ]; then echo "Inbox"; else
        echo "Session ${sid:0:4}  $(cwd_of "$sid")"
        sed -n 's/^Objective: /  Objective: /p' "$dir/$sid.txt" | strip
      fi
      [ -s "$f" ] && strip < "$f" | nl -w2 -s'. ' || echo "  (queue empty)"
    else
      cols=${COLUMNS:-}; [ -z "$cols" ] && [ -t 1 ] && cols=$(tput cols 2>/dev/null); [ "$cols" -ge 10 ] 2>/dev/null || cols=100   # no terminal (a pipe) or a bad COLUMNS: fixed width
      [ "$(count inbox)" -gt 0 ] && printf 'Inbox: %s\n' "$(qsum inbox)" | fit "$cols"
      ids=(); dirs=(); qs=(); ts=(); w=9   # w: width of the DIRECTORY column, grown to the longest name
      while read -r _ t; do
        [ -n "$(find "$t" -mtime -1 2>/dev/null)" ] || continue
        sid=$(basename "$t" .txt); cwd=$(cwd_of "$sid"); d=$(basename "${cwd:-?}"); q=$(qsum "$sid")
        ids+=("${sid:0:4}"); dirs+=("$d"); qs+=("$q"); ts+=("$t"); [ ${#d} -gt "$w" ] && w=${#d}
      done < <(for t in "$dir"/*.txt; do [ -f "$t" ] && echo "$(mtime "$t") $t"; done | sort -rn)
      [ ${#ids[@]} -gt 0 ] && printf '%-4s  %-*s  %s\n' ID "$w" DIRECTORY QUEUE
      for i in "${!ids[@]}"; do
        avail=$(( cols - w - 8 )); [ "$avail" -lt 10 ] && avail=10   # 8 = id column and the gaps
        printf '%-4s  %-*s  %s\n' "${ids[$i]}" "$w" "${dirs[$i]}" "$(printf '%s' "${qs[$i]}" | fit "$avail")"
        sed -n 's/^Objective: /    Objective: /p;s/^Now: */    Now:       /p' "${ts[$i]}" | strip
      done
    fi ;;
  add)  [ $# -ge 2 ] || die "usage: sitrep add <id> <text>"
        sid=$(resolve "$1") || exit 1; shift; item=$(printf '%s' "$*" | clean)
        [ -n "${item//[[:space:]]/}" ] || die "nothing to queue"
        printf '%s\n' "$item" >> "$(qf "$sid")"; echo "queued on $(label "$sid") (now $(count "$sid"))" ;;
  rm)   [ $# -ge 1 ] || die "usage: sitrep rm <id> [item=1]"
        sid=$(resolve "$1") || exit 1; n=${2:-1}; itemno "$n"
        f=$(qf "$sid"); [ -s "$f" ] || die "queue empty"
        item=$(sed -n "${n}p" "$f"); [ -n "$item" ] || die "no item $n on $(label "$sid")"
        t=$(without "$f" "$n" "$item") || die "queue changed; run 'sitrep ls $(label "$sid")'"
        mv "$t" "$f" && printf '%s\n' "$item" | strip ;;
  top)  [ $# -ge 2 ] || die "usage: sitrep top <id> <n>"
        sid=$(resolve "$1") || exit 1; reorder_q "$sid" "$2" 1 ;;
  reorder) [ $# -ge 3 ] || die "usage: sitrep reorder <id> <from> <to>"
        sid=$(resolve "$1") || exit 1; reorder_q "$sid" "$2" "$3" ;;
  pin) [ $# -ge 2 ] || die "usage: sitrep pin <id> <text>"
        sid=$(resolve "$1") || exit 1; shift; f="$dir/$sid.txt"
        [ "$sid" != inbox ] || die "inbox has no objective"
        t=$(tmpfile) || exit 1
        { printf 'Objective: %s\n' "$(printf '%s' "$*" | clean)"; grep -v '^Objective:' "$f" || true; } > "$t"
        mv "$t" "$f" || { rm -f "$t"; exit 1; }
        : > "$dir/.$sid.pinned"   # keeps the summarizer from rewriting it
        echo "objective set on ${sid:0:4}" ;;
  unpin) [ $# -ge 1 ] || die "usage: sitrep unpin <id>"
        sid=$(resolve "$1") || exit 1; [ "$sid" != inbox ] || die "inbox has no objective"
        rm -f "$dir/.$sid.pinned"
        echo "objective on ${sid:0:4} will be summarized again" ;;
  move) [ $# -ge 2 ] || die "usage: sitrep move <from> <to> [item=1]"
        from=$(resolve "$1") || exit 1; to=$(resolve "$2") || exit 1; n=${3:-1}; itemno "$n"
        [ "$from" != "$to" ] || die "from and to are the same queue"
        f=$(qf "$from"); item=$(sed -n "${n}p" "$f" 2>/dev/null); [ -n "$item" ] || die "no item $n on $(label "$from")"
        t=$(without "$f" "$n" "$item") || die "queue changed; run 'sitrep ls $(label "$from")'"
        # append first, then swap the source in: a crash leaves a duplicate, never a lost item
        printf '%s\n' "$item" >> "$(qf "$to")"; mv "$t" "$f" || { rm -f "$t"; die "could not update $(label "$from")"; }
        echo "moved to $(label "$to"): $(printf '%s' "$item" | strip)" ;;
  *) die "usage: sitrep [ls [id]] | add <id> <text> | pin <id> <text> | unpin <id> | rm <id> [n] | top <id> <n> | reorder <id> <from> <to> | move <from> <to> [n]" ;;
esac
