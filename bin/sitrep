#!/bin/bash
# sitrep: per-session work queues for Claude Code sessions. Sessions are addressed by a unique id prefix (shown in the status line and `sitrep ls`).
umask 077
dir="$HOME/.claude/sitrep"
die() { echo "sitrep: $*" >&2; exit 1; }
# Text is untrusted terminal input: drop control (Cc, incl. C1) and format (Cf, incl. bidi) characters.
clean() { perl -CSD -0777 -pe 's/[\n\t\p{Zl}\p{Zp}]/ /g; s/[\p{Cc}\p{Cf}]//g; s/ +$//; $_=substr($_,0,200)' 2>/dev/null; }   # for text being stored: one flat line
fit() { N=$1 perl -CSD -pe 'chomp; $_ = (length > $ENV{N} ? substr($_, 0, $ENV{N} - 1) . "\x{2026}" : $_) . "\n"' 2>/dev/null; }   # cut to N characters with an ellipsis
wrap() { # cols fieldlines itemlines: word-wrap Objective/Progress/Now and queue items with a hanging indent, cut anything else to cols
  C=$1 F=$2 Q=$3 perl -CSD -e '
    my ($C, $F, $Q) = @ENV{qw(C F Q)};
    sub cw { $_[0] =~ /[\x{1100}-\x{115F}\x{2E80}-\x{A4CF}\x{AC00}-\x{D7A3}\x{F900}-\x{FAFF}\x{FE30}-\x{FE6F}\x{FF00}-\x{FF60}\x{FFE0}-\x{FFE6}\x{1F300}-\x{1FAFF}\x{20000}-\x{3FFFD}]/ ? 2 : 1 }   # wide characters take two columns
    sub width { my $n = 0; $n += cw($_) for split //, $_[0]; $n }
    sub cut { my ($s, $w) = @_; my ($o, $n) = ("", 0); for my $c (split //, $s) { my $k = cw($c); last if $n + $k > $w; $o .= $c; $n += $k } $o }
    while (<STDIN>) {
      chomp; my ($pre, $txt, $max);
      if (/^(\s+(?:Objective:|Progress:|Now:)\s+)(.*)$/) { ($pre, $txt, $max) = ($1, $2, $F) }
      elsif (/^(\s+(?:Queue:\s+)?\d+\.\s)(.*)$/) { ($pre, $txt, $max) = ($1, $2, $Q) }
      else { print((width($_) > $C ? cut($_, $C - 1) . "\x{2026}" : $_), "\n"); next }
      my $avail = $C - width($pre); $avail = 10 if $avail < 10;
      my (@lines, $cur); $cur = "";
      for my $wd (split " ", $txt) {
        while (width($wd) > $avail) { push @lines, $cur if $cur ne ""; $cur = ""; my $part = cut($wd, $avail); push @lines, $part; $wd = substr($wd, length $part) }
        if ($cur eq "") { $cur = $wd } elsif (width($cur) + 1 + width($wd) <= $avail) { $cur .= " $wd" } else { push @lines, $cur; $cur = $wd }
      }
      push @lines, $cur if $cur ne ""; @lines = ("") unless @lines;
      if (@lines > $max) { my $rest = join " ", @lines[$max - 1 .. $#lines]; @lines = (@lines[0 .. $max - 2], (width($rest) > $avail ? cut($rest, $avail - 1) . "\x{2026}" : $rest)) }
      print $pre, $lines[0], "\n"; print " " x width($pre), $_, "\n" for @lines[1 .. $#lines];
    }' 2>/dev/null
}
strip() { perl -CSD -pe 's/(?!\n|\t)[\p{Cc}\p{Cf}]//g' 2>/dev/null; }                                                   # for text being shown: keeps line breaks
mtime() { stat -c %Y "$1" 2>/dev/null || stat -f %m "$1" 2>/dev/null; }
tmpfile() { mktemp "$dir/.sitrep.XXXXXX"; }
itemno() { [[ $1 =~ ^[1-9][0-9]*$ ]] || die "item must be a number"; }
cwd_of() { clean 2>/dev/null < "$dir/$1.cwd"; }

resolve() { # prefix -> full session id; `inbox` is the queue of no session and matches exactly
  [[ $1 =~ ^[A-Za-z0-9_-]+$ ]] || die "bad id '$1'"
  [ "$1" = inbox ] && { echo inbox; return; }
  local m=() f
  for f in "$dir"/"$1"*.txt; do [ -f "$f" ] && m+=("$(basename "$f" .txt)"); done
  [ ${#m[@]} -eq 1 ] || die "id '$1' matches ${#m[@]}; run 'sitrep ls'"
  echo "${m[0]}"
}
qf() { echo "$dir/$1.queue"; }
count() { local n; n=$(grep -c . "$(qf "$1")" 2>/dev/null); echo "${n:-0}"; }
label() { if [ "$1" = inbox ]; then echo inbox; else echo "${1:0:4}"; fi; }
qsum() { # id [count]: "empty", "1 item" or "N items", plus the next item unless asked for the count alone
  local n q; n=$(count "$1")
  case "$n" in 0) q="empty" ;; 1) q="1 item" ;; *) q="$n items" ;; esac
  [ "$n" -gt 0 ] && [ "$2" != count ] && q="$q, next: $(head -n 1 "$(qf "$1")" | strip)"
  echo "$q"
}
qlist() { # id max first-prefix other-prefix: the first max items, numbered, then "+K more"
  local n; n=$(count "$1"); [ "$n" -gt 0 ] || return 0
  awk -v n="$2" -v p1="$3" -v p2="$4" -v t="$n" 'NR <= n { printf "%s%d. %s\n", (NR == 1 ? p1 : p2), NR, $0 } END { if (t > n) printf "%s+%d more\n", p2, t - n }' "$(qf "$1")" | strip
}
setting() { # NAME: from the environment, then from sitrep.conf (read, never run); empty when unset
  local v=${!1:-}
  [ -n "$v" ] || v=$(sed -n "s/^$1=//p" "$dir/sitrep.conf" 2>/dev/null | head -n 1 | tr -d "'\"")
  echo "$v"
}
items_default() { local n; n=$(setting SITREP_QUEUE_ITEMS); [[ $n =~ ^[0-9]+$ ]] || n=5; echo "$n"; }
hl_seconds() { local n; n=$(setting SITREP_HIGHLIGHT_SECONDS); [[ $n =~ ^[0-9]+$ ]] || n=60; echo "$n"; }
hl_sgr() { local c re='^[0-9;]+$'; c=$(setting SITREP_HIGHLIGHT_SGR); [[ $c =~ $re ]] || c="48;5;238"; echo "$c"; }   # only digits and semicolons reach the terminal
without() { # file n text: print a temp file holding the queue minus line n; fails if line n is no longer text
  local t; t=$(tmpfile) || return 1
  if E=$3 awk -v n="$2" '{ if (NR == n) { if ($0 != ENVIRON["E"]) bad = 1; else next } print } END { exit bad }' "$1" > "$t"; then echo "$t"; else rm -f "$t"; return 1; fi
}

reorder_q() { # id from to: move item `from` to position `to`
  local sid=$1 from=$2 to=$3 f n item t
  itemno "$from"; itemno "$to"
  f=$(qf "$sid"); n=$(count "$sid")
  [ "$from" -le "$n" ] && [ "$to" -le "$n" ] || die "$(label "$sid") has $n items"
  item=$(sed -n "${from}p" "$f"); t=$(tmpfile) || exit 1
  if E=$item awk -v f="$from" -v t="$to" '{ a[NR] = $0 }
      END { if (a[f] != ENVIRON["E"]) exit 1
            for (i = 1; i <= NR; i++) if (i != f) c[++k] = a[i]
            for (i = 1; i < t; i++) print c[i]
            print a[f]
            for (i = t; i <= k; i++) print c[i] }' "$f" > "$t"; then
    mv "$t" "$f" || { rm -f "$t"; die "could not update $(label "$sid")"; }
    echo "item $to on $(label "$sid"): $(printf '%s' "$item" | strip)"
  else rm -f "$t"; die "queue changed; run 'sitrep ls $(label "$sid")'"; fi
}

agetxt() { # seconds: <1m, 5m, 3h, 2d
  local s=$1
  if [ "$s" -lt 60 ]; then echo "<1m"; elif [ "$s" -lt 3600 ]; then echo "$(( s / 60 ))m"
  elif [ "$s" -lt 86400 ]; then echo "$(( s / 3600 ))h"; else echo "$(( s / 86400 ))d"; fi
}
sword() { # id: the session's state word, from an allow-list (the file is untrusted input), else -
  local w=- f="$dir/.$1.state"
  [ -f "$f" ] && read -r w < "$f"
  case "$w" in working|waiting|ended) echo "$w" ;; *) echo - ;; esac
}
tquiet() { # id now: seconds since the session's transcript last changed (the shortest, if there are several); empty when there is none
  local tr trm q="" n
  for tr in "${CLAUDE_CONFIG_DIR:-$HOME/.claude}"/projects/*/"$1".jsonl; do   # an interrupt fires no Stop; the transcript still shows life
    [ -f "$tr" ] && [ ! -L "$tr" ] || continue
    trm=$(mtime "$tr"); [ -n "$trm" ] || continue
    n=$(( $2 - trm )); { [ -z "$q" ] || [ "$n" -lt "$q" ]; } && q=$n
  done
  echo "$q"
}
stext() { # id changed now: "waiting 3m"; a working session whose transcript has been quiet for 10 minutes is "idle?"
  local w c q; w=$(sword "$1")
  [ "$w" = - ] && { echo -; return; }
  if [ "$w" = working ]; then
    q=$(tquiet "$1" "$3"); [ -n "$q" ] && [ "$q" -gt 600 ] && { echo "idle? $(agetxt "$q")"; return; }
  fi
  c=$(agetxt $(( $3 - $2 ))); echo "$w $c"
}

local_domain() { # how Claude Code names this machine's pid space; empty when it cannot be worked out
  if [ "$(uname)" = Darwin ]; then echo darwin
  else local id ns; id=$(cat /etc/machine-id 2>/dev/null); ns=$(readlink /proc/self/ns/pid 2>/dev/null); [ -n "$id" ] && [ -n "$ns" ] && echo "darwin:$id:$ns"; fi
}
live_ids() { # "id pid" for each session with a live process, from Claude Code's registry (~/.claude/sessions/<pid>.json); the pid is - when it is in another pid space. Fails when nothing live can be read
  local d="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/sessions" ldom pid sid pstart dom st want f have=0 any=0
  for f in "$d"/*.json; do [ -f "$f" ] && { have=1; break; }; done; [ "$have" = 1 ] || return 1
  ldom=$(local_domain)
  while IFS=$'\t' read -r pid sid pstart dom; do   # the files are untrusted input: check what is used
    [[ $pid =~ ^[0-9]+$ ]] && [[ $sid =~ ^[A-Za-z0-9_-]+$ ]] || continue
    if [ -n "$dom" ] && [ -n "$ldom" ] && [ "$dom" != "$ldom" ]; then echo "$sid -"; any=1; continue; fi   # another pid space: cannot judge, count as alive, and the pid means nothing here
    kill -0 "$pid" 2>/dev/null || continue
    st=$(LC_ALL=C TZ=UTC ps -o lstart= -p "$pid" 2>/dev/null | tr -s ' '); st=${st# }; st=${st% }
    want=$(printf '%s' "$pstart" | tr -s ' '); want=${want# }; want=${want% }
    if [ -n "$st" ] && [ -n "$want" ] && [ "$st" != "$want" ]; then continue; fi   # the pid was reused by another process
    echo "$sid $pid"; any=1
  done < <(jq -r '[.pid, .sessionId, .procStart, (.pidDomain // "")] | map(tostring) | join("\t")' "$d"/*.json 2>/dev/null)
  [ "$any" = 1 ]
}
deadp() { # id changed: is the session over? Needs $reg (1 when the registry could be read), $live and $now.
  local w; w=$(sword "$1")
  if [ "$reg" = 1 ]; then
    case $'\n'"$live" in *$'\n'"$1 "*) return 1 ;; esac   # a live process has this id, whatever the state file says
    [ "$w" = ended ] || [ $(( now - $2 )) -gt 120 ]   # not registered: over once it said so, or after two quiet minutes (the registry lags a start and a /clear)
  else [ "$w" = ended ]; fi
}
setended() { local t; t=$(tmpfile) && printf 'ended\n' > "$t" && mv "$t" "$dir/.$1.state"; }

termsize() { # sets rows and cols: LINES/COLUMNS, then the terminal, then 24x100 (a pipe or a bad value)
  rows=${LINES:-}; cols=${COLUMNS:-}
  if [ -t 1 ] && { [ -z "$rows" ] || [ -z "$cols" ]; }; then
    local sz; sz=$(stty size </dev/tty 2>/dev/null) && { rows=${rows:-${sz% *}}; cols=${cols:-${sz#* }}; }
  fi
  [ "$rows" -ge 3 ] 2>/dev/null || rows=24
  [ "$cols" -ge 10 ] 2>/dev/null || cols=100
}

gather() { # all: collect the sessions active in the last day, newest first, for render_frame
  # Bash scoping lets it fill the caller's locals: now live reg ended strand ids full dirs sts ages isend ts.
  # A finished session is counted in ended (and its queue items in strand), and listed only when all is 1.
  local all=$1 m t sid cwd st key
  now=$(date +%s)
  live=$(live_ids); [ -n "$live" ] && reg=1   # one registry read per frame
  while read -r m t; do
    [ $(( now - m )) -lt 86400 ] || continue   # active in the last day
    sid=$(basename "$t" .txt)
    if deadp "$sid" "$m"; then
      if [ "$all" != 1 ]; then ended=$(( ended + 1 )); strand=$(( strand + $(count "$sid") )); continue; fi
      st="ended $(agetxt $(( now - m )))"; isend+=(1)
    else isend+=(0); st=$(stext "$sid" "$m" "$now"); case "$st" in ended*) st="running ${st#ended }" ;; esac   # alive in the registry, so a stale ended is not true
    fi
    ages+=($(( now - m ))); sts+=("$st")
    cwd=$(cwd_of "$sid")
    ids+=("${sid:0:4}"); full+=("$sid"); dirs+=("$(basename "${cwd:-?}")"); ts+=("$t")
  done < <(for t in "$dir"/*.txt; do   # newest first, by when the state last changed (else when the notes did)
    [ -f "$t" ] || continue; key=${t##*/}; key="$dir/.${key%.txt}.state"; [ -f "$key" ] || key=$t
    echo "$(mtime "$key") $t"
  done | sort -rn)
}

json_frame() { # all cap: one JSON document for the running sessions (all: finished ones too); cap limits each queue's items, -1 for none
  local all=$1 cap=$2 now live reg=0 ended=0 strand=0 isend=() ages=() sts=() ids=() full=() dirs=() ts=() i k sid w run state quiet idle needs snoozed sv pin hl hlsec q rest pid meta="" sep="" args=() out
  gather "$all"
  hlsec=$(hl_seconds)
  for i in "${!full[@]}"; do
    sid=${full[$i]}; [[ $sid =~ ^[A-Za-z0-9_-]+$ ]] || continue   # ids come from file names; anything else is not ours
    w=$(sword "$sid"); run=true; [ "${isend[$i]}" = 1 ] && run=false
    state=$w; if [ "$run" = false ]; then state=ended; elif [ "$w" = ended ]; then state=running; fi   # alive in the registry, so a stale ended is not true
    pid=null   # the live process, when the registry names one here; the first, if a resume left several
    if [ "$run" = true ]; then case $'\n'"$live" in *$'\n'"$sid "*) rest=${live#*"$sid "}; rest=${rest%%$'\n'*}; [[ $rest =~ ^[0-9]+$ ]] && pid=$rest ;; esac; fi
    quiet=null; idle=false; needs=false; snoozed=false
    if [ "$run" = true ] && [ "$w" = waiting ]; then needs=true   # Claude has stopped and the turn is the user's, until the next prompt
      # `sitrep snooze` stored when the state last changed; while that is still the time, the user has muted it
      if [ -f "$dir/.$sid.snooze" ]; then read -r sv < "$dir/.$sid.snooze"; [ "$sv" = "$(( now - ages[i] ))" ] && { needs=false; snoozed=true; }; fi
    fi
    if [ "$w" = working ] && [ "$run" = true ]; then q=$(tquiet "$sid" "$now"); [ -n "$q" ] && quiet=$q; fi
    [[ ${sts[$i]} == "idle?"* ]] && idle=true
    pin=false; [ -e "$dir/.$sid.pinned" ] && pin=true
    hl=false; [ "$run" = true ] && [ "$hlsec" -gt 0 ] && [ "${ages[$i]}" -le "$hlsec" ] && hl=true
    [[ ${sts[$i]} =~ ^[a-z?]+(\ [0-9\<]+[mhd]?)?$ ]] || sts[i]=-   # the label is built from known words; only such a label goes into the JSON
    meta+="$sep{\"i\":$i,\"id\":\"$sid\",\"short\":\"${sid:0:4}\",\"running\":$run,\"state\":\"$state\",\"state_label\":\"${sts[$i]}\",\"age\":${ages[$i]},\"state_changed\":$(( now - ages[i] )),\"quiet_secs\":$quiet,\"idle\":$idle,\"needs_input\":$needs,\"snoozed\":$snoozed,\"pid\":$pid,\"pinned\":$pin,\"highlight\":$hl}"; sep=","
    for k in t:txt c:cwd q:queue; do   # a file that is missing or unreadable reads as empty, so one bad file does not blank the listing
      if [ -f "$dir/$sid.${k#*:}" ] && [ -r "$dir/$sid.${k#*:}" ]; then args+=(--rawfile "${k%%:*}$i" "$dir/$sid.${k#*:}"); else args+=(--rawfile "${k%%:*}$i" /dev/null); fi
    done
  done
  if [ -f "$(qf inbox)" ] && [ -r "$(qf inbox)" ]; then args+=(--rawfile inbox "$(qf inbox)"); else args+=(--rawfile inbox /dev/null); fi
  out=$(printf '[%s]' "$meta" | jq -n "${args[@]}" --argjson cap "$cap" --argjson now "$now" \
      --arg reg "$([ "$reg" = 1 ] && echo ok || echo unavailable)" \
      --argjson hidden "{\"ended\":$ended,\"stranded_items\":$strand}" \
      --argjson settings "{\"queue_items\":$(items_default),\"highlight_seconds\":$hlsec,\"highlight_sgr\":\"$(hl_sgr)\"}" '
    def clean: gsub("\t"; " ") | gsub("[\\p{Cc}\\p{Cf}\\p{Zl}\\p{Zp}]"; "") | sub(" +$"; "");   # control and format characters never reach a consumer
    def field($txt; $k): ($txt | split("\n") | map(select(startswith($k + ":"))) | first // "") | sub("^[^:]*: *"; "") | clean | .[0:200];
    def items($txt): [$txt | split("\n")[] | clean | select(test("\\S")) | .[0:200]];
    def queue($txt): items($txt) | {count: length, items: (if $cap < 0 then . else .[0:$cap] end)};
    input as $meta | $ARGS.named as $n   # $meta arrives on stdin: one argument is capped at 128 KB on Linux
    | { version: 1, generated: $now, registry: $reg, settings: $settings, hidden: $hidden,
        inbox: queue($n.inbox),
        sessions: [ $meta[] as $m
          | $n["t\($m.i)"] as $t | $n["c\($m.i)"] as $c | $n["q\($m.i)"] as $q
          | (($c | split("\n")[0] // "") | clean) as $cwd
          | ($m | del(.i)) + { dir: ($cwd | split("/") | map(select(length > 0)) | last // "?"), cwd: $cwd[0:300],
              objective: field($t; "Objective"), progress: field($t; "Progress"), now: field($t; "Now"), queue: queue($q) } ] }') || return 1
  printf '%s\n' "$out"
}

render_frame() { # verbose rows cols items all wraplines highlight-seconds: the Inbox, then a table of running sessions (all: finished ones too). rows 0 means no height limit.
  # With verbose and items above 0 each queue is listed (at most items entries) and the header shows the count alone.
  local v=$1 rows=$2 cols=$3 items=$4 all=$5 wrapn=${6:-3} hl=${7:-0} itemn strand=0 live reg=0 isend=() ages=() list=0 expr l sw=5 st ended=0 sts=() ids=() dirs=() qs=() ts=() w=9 now d i avail blk nlc
  local foot full=() head=() blocks=() bn=() out=() used shown=0 cap total=0
  gather "$all"
  { [ "$v" = 1 ] && [ "$items" -gt 0 ]; } && list=1
  expr='s/^Objective: /    Objective: /p;s/^Now: */    Now:       /p'
  [ "$v" = 1 ] && expr='s/^Objective: /    Objective: /p;s/^Progress: */    Progress:  /p;s/^Now: */    Now:       /p'
  for i in "${!full[@]}"; do   # what depends on the view: column widths, and the queue text
    st=${sts[$i]}; [ ${#st} -gt "$sw" ] && sw=${#st}
    d=${dirs[$i]}; [ ${#d} -gt "$w" ] && w=${#d}   # w: width of the DIRECTORY column
    if [ "$list" = 1 ]; then qs+=("$(qsum "${full[$i]}" count)"); else qs+=("$(qsum "${full[$i]}")"); fi
  done
  if [ "$(count inbox)" -gt 0 ]; then
    if [ "$list" = 1 ]; then
      head+=("$(printf 'Inbox: %s' "$(qsum inbox count)" | fit "$cols")")
      while IFS= read -r l; do head+=("$(printf '%s' "$l" | fit "$cols")"); done < <(qlist inbox "$items" "    " "    ")
    else head+=("$(printf 'Inbox: %s' "$(qsum inbox)" | fit "$cols")"); fi
  fi
  [ ${#ids[@]} -gt 0 ] && head+=("$(printf '%-4s  %-*s  %-*s  %s' ID "$w" DIRECTORY "$sw" STATE QUEUE | { if [ "$rows" -gt 0 ]; then fit "$cols"; else cat; fi; })")
  avail=$(( cols - w - sw - 10 )); [ "$avail" -lt 10 ] && avail=10   # 10 = id column and the gaps
  for i in "${!ids[@]}"; do
    blk=$(printf '%-4s  %-*s  %-*s  %s\n' "${ids[$i]}" "$w" "${dirs[$i]}" "$sw" "${sts[$i]}" "$(printf '%s' "${qs[$i]}" | fit "$avail")"
          sed -n "$expr" "${ts[$i]}" | strip
          [ "$list" = 1 ] && qlist "${full[$i]}" "$items" "    Queue:     " "               ")
    itemn=2; [ "$wrapn" -lt 2 ] && itemn=1   # queue items get fewer lines than the fields
    [ "$rows" -gt 0 ] && blk=$(printf '%s' "$blk" | tr '\t' ' ' | wrap "$cols" "$wrapn" "$itemn")   # a tab can span 8 columns
    if [ "$hl" -gt 0 ] && [ "${ages[$i]}" -le "$hl" ] && [ "${isend[$i]}" = 0 ]; then blk=$(printf '%s\n' "$blk" | sed $'s/^/\001/'); fi   # \001 marks a line for the highlight; watch_loop draws it
    nlc=${blk//[!$'\n']/}; blocks+=("$blk"); bn+=($(( ${#nlc} + 1 ))); total=$(( total + ${#nlc} + 1 ))
  done
  used=${#head[@]}; cap=0; foot=0; [ "$ended" -gt 0 ] && foot=1; [ "$strand" -gt 0 ] && foot=$(( foot + 1 ))   # foot: the ended lines always get their own rows
  if [ "$rows" -gt 0 ] && [ $(( used + total + foot )) -gt "$rows" ]; then cap=$(( rows - 1 - foot )); fi   # too tall: sessions leave room for "+N more" and the ended line
  out=("${head[@]}")
  for i in "${!blocks[@]}"; do
    if [ "$cap" -gt 0 ] && [ $(( used + bn[i] )) -gt "$cap" ]; then break; fi
    out+=("${blocks[$i]}"); used=$(( used + bn[i] )); shown=$(( shown + 1 ))
  done
  if [ "$shown" -lt ${#blocks[@]} ]; then out+=("+$(( ${#blocks[@]} - shown )) more"); fi
  if [ "$ended" -gt 0 ]; then out+=("+$ended ended (--all)"); fi
  if [ "$strand" -gt 0 ]; then out+=("$strand items stranded in ended sessions (sitrep prune)"); fi
  [ ${#out[@]} -gt 0 ] || return 0
  printf '%s\n' "${out[@]}" | { if [ "$rows" -gt 0 ]; then head -n "$rows"; else cat; fi; }   # a tiny pane still gets at most rows lines
}

sig() { # one stat over the state files: names, sizes and mtimes; a directory mtime misses in-place appends
  local files=() f
  for f in "$dir"/*.txt "$dir"/*.queue "$dir"/.*.state; do [ -e "$f" ] && files+=("$f"); done
  [ ${#files[@]} -gt 0 ] || return 0
  if stat -c %Y "${files[0]}" >/dev/null 2>&1; then stat -c '%Y %s %n' "${files[@]}" 2>/dev/null   # GNU first: BSD-style `stat -f` succeeds with other output on Linux
  else stat -f '%m %z %N' "${files[@]}" 2>/dev/null; fi
  printf '%s\n' "${CLAUDE_CONFIG_DIR:-$HOME/.claude}"/sessions/*.json   # a session starting or exiting adds or drops a file
}

watch_loop() { # seconds (with $items, $all, $wrapn and $hl set): redraw every N seconds, and at once when a state file or the terminal size changes
  local interval=$1 last="" lastdraw=0 s now frame l key tty=0 sgr; sgr=$(hl_sgr)
  { : </dev/tty; } 2>/dev/null && tty=1   # a readable terminal: wait on it, so a key wakes the loop
  [[ $interval =~ ^[1-9][0-9]*$ ]] || die "usage: sitrep watch [--once] [-a] [-n items] [seconds]"
  trap 'printf "\033[?7h\033[?25h"' EXIT; trap 'exit 130' INT TERM
  printf '\033[?25l\033[?7l'   # hide the cursor and clip, not wrap, a line that is too wide
  while :; do
    termsize; now=$(date +%s); s="$(sig)|$rows|$cols"
    if [ "$s" != "$last" ] || [ $(( now - lastdraw )) -ge "$interval" ]; then
      frame=$(render_frame 1 $(( rows - 1 )) "$cols" "$items" "$all" "$wrapn" "$hl"); [ -n "$frame" ] || frame="No running sessions."
      printf '\033[H'; while IFS= read -r l; do
        if [[ $l == $'\001'* ]]; then printf '\033[%sm%s\033[K\033[0m\n' "$sgr" "${l#$'\001'}"; else printf '%s\033[K\n' "$l"; fi   # \033[K fills the rest of the row with the background
      done <<<"$frame"; printf '\033[J'
      last=$s; lastdraw=$now
    fi
    if [ "$tty" = 1 ]; then
      if read -t 1 -n 1 -r -s key </dev/tty 2>/dev/null; then [ "$key" = q ] && exit 0; fi   # q quits; a timeout is the normal tick
    else sleep 1; fi
  done
}

tui_bin() { # the optional Go dashboard: $SITREP_TUI, then next to this script (through a symlink), then PATH
  local self=$0 d p t n=0
  if [ -n "$SITREP_TUI" ]; then [ -f "$SITREP_TUI" ] && [ -x "$SITREP_TUI" ] && echo "$SITREP_TUI"; return; fi
  while [ -L "$self" ] && [ "$n" -lt 20 ]; do   # follow a chain of links; a relative target is relative to the link's own directory
    t=$(readlink "$self"); case "$t" in /*) self=$t ;; *) self=$(dirname "$self")/$t ;; esac; n=$(( n + 1 ))
  done
  d=$(cd "$(dirname "$self")" 2>/dev/null && pwd) && p="$d/sitrep-tui"
  if [ -n "$p" ] && [ -f "$p" ] && [ -x "$p" ]; then echo "$p"; return; fi
  command -v sitrep-tui
}

help_all() {
  cat <<'EOF'
usage: sitrep <command> [args]

  ls [id]                    list running sessions, or one queue
  add <id> <text>            append an item to a queue
  rm <id> [n]                remove an item and print it
  top <id> <n>               move an item to the front of a queue
  reorder <id> <from> <to>   move an item to another position
  move <from> <to> [n]       hand an item to another queue (--item <text> guards it)
  pin <id> <text>            fix a session's Objective
  unpin <id>                 let the summarizer rewrite the Objective
  snooze [--off] <id>        mute the needs-you state of a session until it changes
  prune                      clear out sessions that are gone
  watch                      live dashboard of running sessions
  tui                        optional full-screen dashboard with tabs; needs a Go build
  help [command]             this list, or the details of one command

An <id> is a unique prefix of a session id, or "inbox".
Add --help to any command for its details.
EOF
}

help_for() { # command: print its details; fails for an unknown command
  case "$1" in
    ls) cat <<'EOF'
usage: sitrep ls [-a] [-v] [-n items] [id]
       sitrep ls --json [-a] [-n items | --full]

List running sessions with their state, queue, Objective and Now. With an id, list
that queue instead; an id of inbox lists the inbox.

  -a, --all   include ended sessions
  -v          add the Progress line, and list each queue
  -n items    how many items each queue lists; implies -v, and 0 gives the count and
              the next item only
  --json      print one JSON document for programs, see the README; -n caps the items
              in each queue, and --full lists them all

The default for -n is 5, or SITREP_QUEUE_ITEMS from the environment or sitrep.conf.
EOF
    ;;
    add) cat <<'EOF'
usage: sitrep add <id> <text>

Append an item to a queue. The text is one line of at most 200 characters, and longer
text is cut. Quote text that holds shell characters such as ( ) ; or &.

  sitrep add 15f1 'fix the flaky test (CI)'
  sitrep add inbox 'look at the nightly job'
EOF
    ;;
    rm) cat <<'EOF'
usage: sitrep rm <id> [n]

Remove item n (default 1) from a queue and print it. It refuses when the queue
changed after it was read, so it never removes a different item.
EOF
    ;;
    top) cat <<'EOF'
usage: sitrep top <id> <n>

Move item n to the front of a queue, so that it is the next item.
EOF
    ;;
    reorder) cat <<'EOF'
usage: sitrep reorder <id> <from> <to>

Move the item at position from to position to. The other items keep their order.
EOF
    ;;
    move) cat <<'EOF'
usage: sitrep move <from> <to> [n] [--item <text>]

Hand item n (default 1) from one queue to another. Either side may be inbox. The item
is added to the destination before it leaves the source, so a failure can leave a
duplicate but never lose it. With --item, it refuses unless item n is exactly that
text, so a program that showed a list never moves a different item.
EOF
    ;;
    pin) cat <<'EOF'
usage: sitrep pin <id> <text>

Set a session's Objective and stop the summarizer from changing it. Inside a session,
a prompt that starts with "+pin " does the same. See unpin.
EOF
    ;;
    unpin) cat <<'EOF'
usage: sitrep unpin <id>

Let the summarizer rewrite a session's Objective again.
EOF
    ;;
    snooze) cat <<'EOF'
usage: sitrep snooze [--off] <id>

Mute the "waiting for you" state of one session, so that a program such as sitrep-tui stops
drawing it as needing you. The mute ends by itself when the session changes: the next
prompt, or the end of the next turn. `--off` ends it at once. Only the JSON changes: the
`needs_input` field turns false and `snoozed` turns true.
EOF
    ;;
    prune) cat <<'EOF'
usage: sitrep prune [-y | -k | --dry-run]

Mark each session that is no longer running as ended. For a session that still holds
queue items, ask whether to move them to the inbox.

  -y          answer yes to every question
  -k, --keep  mark the sessions ended, leave every queue where it is, and ask nothing;
              for a program with no one to answer
  --dry-run   say what would happen, and change nothing

The three options exclude one another.

It reads Claude Code's live-session registry and changes nothing if it cannot. It never
touches a running session or one under two minutes old, and never deletes a queue.
EOF
    ;;
    watch) cat <<'EOF'
usage: sitrep watch [--once] [-a] [-n items] [--wrap lines] [--highlight seconds] [seconds]

A live view of every running session, for a spare terminal pane. It redraws every N
seconds (default 2) and at once when a state file or the pane size changes. Press q or
Ctrl-C to leave. Without a terminal it prints one frame and exits.

  --once              print one frame and exit
  -a, --all           include ended sessions
  -n items            how many items each queue lists (default 5; 0 for the next item only)
  --wrap lines        lines a field may take (default 3); queue items get 2, or 1 if this is 1
  --highlight seconds colour sessions active in the last N seconds (default 60; 0 for none)

Settings, in the environment or sitrep.conf: SITREP_QUEUE_ITEMS, SITREP_HIGHLIGHT_SECONDS
and SITREP_HIGHLIGHT_SGR. NO_COLOR turns the highlight off.
EOF
    ;;
    tui) cat <<'EOF'
usage: sitrep tui [--tab watch|top] [--interval 3s] [--once] [--width n] [--quit-on-jump]
                  [--read-only] [--no-bell]

Run sitrep-tui, an optional full-screen dashboard with a Watch tab and a Top tab and a
status bar. It gets everything from `sitrep ls --json` and changes nothing itself. It is
not built by default: run `make tui` in the claude-sitrep checkout, which needs Go 1.26
or newer.

Keys: up, down, j and k move the selection; enter jumps to the session's tmux pane or cmux
surface; d or space opens the session in full; tab, shift-tab, left, right, 1 and 2 switch
tabs; a shows or hides ended sessions; s sorts Top; y or Y copies the session id or its
resume command; z snoozes a session until it changes; / filters the sessions (enter keeps the
filter, esc clears it); i opens the inbox, where t takes the selected item into the session that
was selected, after a y or n, and adds it to the end of that queue; p prunes sessions that are
gone, after a preview and a y or n; r refreshes; ? lists the keys; q quits.

--once prints one frame as plain text and exits, --quit-on-jump leaves the dashboard after
a good jump, for a tmux popup, --read-only turns off p, z and every other key that changes
state, and --no-bell stops the bell that rings when a session starts needing you.

sitrep-tui is found through $SITREP_TUI, then next to this script, then on PATH.
EOF
    ;;
    help) cat <<'EOF'
usage: sitrep help [command]

List the commands, or show the details of one. `sitrep <command> --help` shows the same.
EOF
    ;;
    *) return 1 ;;
  esac
}

cmd=${1:-ls}; [ $# -gt 0 ] && shift
case "$1" in -h|--help) case "$cmd" in help|-h|--help) ;; *) help_for "$cmd" || die "unknown command '$cmd'; run 'sitrep help'"; exit 0 ;; esac ;; esac
case "$cmd" in
  ls)
    v=0; items=""; all=0; json=0; noncap=0
    while :; do case "$1" in   # -v adds Progress and the queue lists; -n sets how many items, and implies -v; -a includes finished sessions
      -v) v=1; shift ;;
      --json) json=1; shift ;;
      --full) noncap=1; shift ;;
      -a|--all) all=1; shift ;;
      -n) [ $# -ge 2 ] || die "usage: sitrep ls [-a] [-v] [-n items] [--json [--full]] [id]"; items=$2; v=1; shift 2 ;;
      *) break ;;
    esac; done
    [ -n "$items" ] || items=$(items_default); [[ $items =~ ^[0-9]+$ ]] || die "items must be a number"
    [ "$noncap" = 0 ] || [ "$json" = 1 ] || die "--full needs --json"
    for a in "$@"; do [ "$a" != --json ] || die "--json goes before an id, and takes none"; done
    if [ "$json" = 1 ]; then   # a machine-readable listing of every session; with -n items per queue, or --full for all
      [ -z "$1" ] || die "usage: sitrep ls --json [-a] [-n items | --full]"
      cap=$items; [ "$noncap" = 1 ] && cap=-1
      json_frame "$all" "$cap" || die "could not build the JSON"
    elif [ -n "$1" ]; then
      sid=$(resolve "$1") || exit 1; f=$(qf "$sid")
      if [ "$sid" = inbox ]; then echo "Inbox"; else
        key="$dir/.$sid.state"; [ -f "$key" ] || key="$dir/$sid.txt"
        st=$(stext "$sid" "$(mtime "$key")" "$(date +%s)"); [ "$st" = - ] && st="" || st="  ($st)"
        echo "Session ${sid:0:4}  $(cwd_of "$sid")$st"
        sed -n 's/^Objective: /  Objective: /p' "$dir/$sid.txt" | strip
      fi
      [ -s "$f" ] && strip < "$f" | nl -w2 -s'. ' || echo "  (queue empty)"
    else
      termsize; render_frame "$v" 0 "$cols" "$items" "$all"
    fi ;;
  watch) once=0; items=""; all=0; wrapn=3; hl=""
        while :; do case "$1" in
          --once) once=1; shift ;;
          --highlight) [ $# -ge 2 ] && [[ $2 =~ ^[0-9]+$ ]] || die "usage: sitrep watch [--once] [-a] [-n items] [--wrap lines] [--highlight seconds] [seconds]"; hl=$2; shift 2 ;;
          --wrap) [ $# -ge 2 ] && [[ $2 =~ ^[1-9][0-9]*$ ]] || die "usage: sitrep watch [--once] [-a] [-n items] [--wrap lines] [--highlight seconds] [seconds]"; wrapn=$2; shift 2 ;;
          -a|--all) all=1; shift ;;
          -n) [ $# -ge 2 ] || die "usage: sitrep watch [--once] [-a] [-n items] [--wrap lines] [--highlight seconds] [seconds]"; items=$2; shift 2 ;;
          *) break ;;
        esac; done
        [ -n "$items" ] || items=$(items_default); [[ $items =~ ^[0-9]+$ ]] || die "items must be a number"
        [ $# -le 1 ] || die "usage: sitrep watch [--once] [-a] [-n items] [--wrap lines] [--highlight seconds] [seconds]"   # nothing may follow the interval
        [ -n "$hl" ] || hl=$(hl_seconds); [ -z "$NO_COLOR" ] || hl=0   # NO_COLOR turns the highlight off
        # a pipe or a terminal that cannot move the cursor gets one frame, never a loop of escape codes
        { [ -t 1 ] && [ -n "$TERM" ] && [ "$TERM" != dumb ]; } || once=1
        if [ "$once" = 1 ]; then
          termsize; frame=$(render_frame 1 "$rows" "$cols" "$items" "$all" "$wrapn"); printf '%s\n' "${frame:-No running sessions.}"
        else watch_loop "${1:-2}"; fi ;;
  prune) yes=0; dry=0; keep=0; asked=0
        for a in "$@"; do case "$a" in -y|--yes) yes=1 ;; --dry-run) dry=1 ;; -k|--keep) keep=1 ;; *) die "usage: sitrep prune [-y | -k | --dry-run]" ;; esac; done
        [ $(( yes + dry + keep )) -le 1 ] || die "usage: sitrep prune [-y | -k | --dry-run]"
        live=$(live_ids); [ -n "$live" ] || die "cannot read the live-session registry in ${CLAUDE_CONFIG_DIR:-$HOME/.claude}/sessions; nothing changed"
        reg=1; now=$(date +%s); marked=0; moved=0; tty=0; { : </dev/tty; } 2>/dev/null && tty=1
        for t in "$dir"/*.txt; do
          [ -f "$t" ] || continue; sid=${t##*/}; sid=${sid%.txt}
          key="$dir/.$sid.state"; [ -f "$key" ] || key=$t; m=$(mtime "$key"); [ -n "$m" ] || continue
          deadp "$sid" "$m" || continue   # a session that is alive, or too new to judge, is never touched
          n=$(count "$sid"); cwd=$(cwd_of "$sid"); d=$(basename "${cwd:-?}")
          if [ "$(sword "$sid")" != ended ]; then
            if [ "$dry" = 1 ]; then echo "would mark ${sid:0:4} ($d) ended"; else setended "$sid" && echo "marked ${sid:0:4} ($d) ended"; fi
            marked=$(( marked + 1 ))
          fi
          [ "$n" -gt 0 ] || continue
          if [ "$dry" = 1 ]; then echo "would ask: move $n item(s) from ${sid:0:4} ($d) to the inbox"; asked=$(( asked + n )); continue; fi
          ans=n
          if [ "$keep" = 1 ]; then echo "kept $n item(s) on ${sid:0:4} ($d)"   # never asks, never moves: for a caller with no one to answer
          elif [ "$yes" = 1 ]; then ans=y
          elif [ "$tty" = 1 ]; then printf 'Move %s item(s) from %s (%s) to the inbox? [y/N] ' "$n" "${sid:0:4}" "$d" >&2; read -r ans </dev/tty || ans=n
          else echo "$n item(s) left on ${sid:0:4} ($d): run prune in a terminal, or use -y" >&2; fi
          case "$ans" in y|Y|yes) for (( i = 0; i < n; i++ )); do bash "$0" move "$sid" inbox 1 >/dev/null || break; moved=$(( moved + 1 )); done ;; esac
        done
        if [ "$dry" = 1 ]; then echo "would mark $marked ended, would ask about $asked item(s)"; else echo "$marked marked ended, $moved item(s) moved to the inbox"; fi ;;
  tui)  bin=$(tui_bin)
        [ -n "$bin" ] || die "sitrep-tui is not built; run 'make tui' in the claude-sitrep checkout (needs Go 1.26 or newer)"
        case $0 in /*) me=$0 ;; *) me=$PWD/$0 ;; esac   # an absolute path, so the dashboard never searches PATH for it
        SITREP_BIN=$me exec "$bin" "$@" ;;   # the dashboard runs this very script, so their versions match
  snooze) off=0; [ "$1" = --off ] && { off=1; shift; }
        [ $# -eq 1 ] || die "usage: sitrep snooze [--off] <id>"
        sid=$(resolve "$1") || exit 1; [ "$sid" != inbox ] || die "the inbox is not a session"
        if [ "$off" = 1 ]; then rm -f "$dir/.$sid.snooze"; echo "$(label "$sid") is no longer snoozed"
        else
          key="$dir/.$sid.state"; [ -f "$key" ] || key="$dir/$sid.txt"
          m=$(mtime "$key"); [[ $m =~ ^[0-9]+$ ]] || die "cannot read when $(label "$sid") last changed"
          if ! { t=$(tmpfile) && printf '%s\n' "$m" > "$t" && mv "$t" "$dir/.$sid.snooze"; }; then die "cannot snooze $(label "$sid")"; fi
          echo "snoozed $(label "$sid") until it changes"
        fi ;;
  help|-h|--help) case "$1" in
          "") help_all ;;
          -h|--help) help_for help ;;
          *) help_for "$1" || die "no help for '$1'; run 'sitrep help'" ;;
        esac ;;
  add)  [ $# -ge 2 ] || die "usage: sitrep add <id> <text>"
        sid=$(resolve "$1") || exit 1; shift; item=$(printf '%s' "$*" | clean)
        [ -n "${item//[[:space:]]/}" ] || die "nothing to queue"
        printf '%s\n' "$item" >> "$(qf "$sid")"; echo "queued on $(label "$sid") (now $(count "$sid"))" ;;
  rm)   [ $# -ge 1 ] || die "usage: sitrep rm <id> [item=1]"
        sid=$(resolve "$1") || exit 1; n=${2:-1}; itemno "$n"
        f=$(qf "$sid"); [ -s "$f" ] || die "queue empty"
        item=$(sed -n "${n}p" "$f"); [ -n "$item" ] || die "no item $n on $(label "$sid")"
        t=$(without "$f" "$n" "$item") || die "queue changed; run 'sitrep ls $(label "$sid")'"
        mv "$t" "$f" && printf '%s\n' "$item" | strip ;;
  top)  [ $# -ge 2 ] || die "usage: sitrep top <id> <n>"
        sid=$(resolve "$1") || exit 1; reorder_q "$sid" "$2" 1 ;;
  reorder) [ $# -ge 3 ] || die "usage: sitrep reorder <id> <from> <to>"
        sid=$(resolve "$1") || exit 1; reorder_q "$sid" "$2" "$3" ;;
  pin) [ $# -ge 2 ] || die "usage: sitrep pin <id> <text>"
        sid=$(resolve "$1") || exit 1; shift; f="$dir/$sid.txt"
        [ "$sid" != inbox ] || die "inbox has no objective"
        t=$(tmpfile) || exit 1
        { printf 'Objective: %s\n' "$(printf '%s' "$*" | clean)"; grep -v '^Objective:' "$f" || true; } > "$t"
        mv "$t" "$f" || { rm -f "$t"; exit 1; }
        : > "$dir/.$sid.pinned"   # keeps the summarizer from rewriting it
        echo "objective set on ${sid:0:4}" ;;
  unpin) [ $# -ge 1 ] || die "usage: sitrep unpin <id>"
        sid=$(resolve "$1") || exit 1; [ "$sid" != inbox ] || die "inbox has no objective"
        rm -f "$dir/.$sid.pinned"
        echo "objective on ${sid:0:4} will be summarized again" ;;
  move) [ $# -ge 2 ] || die "usage: sitrep move <from> <to> [item=1] [--item <text>]"
        from=$(resolve "$1") || exit 1; to=$(resolve "$2") || exit 1; shift 2; n=1; want=; guard=0
        [[ ${1:-} =~ ^[0-9]+$ ]] && { n=$1; shift; }
        if [ "${1:-}" = --item ]; then [ $# -eq 2 ] || die "usage: sitrep move <from> <to> [item=1] [--item <text>]"; guard=1; want=$2; shift 2; fi
        [ $# -eq 0 ] || die "usage: sitrep move <from> <to> [item=1] [--item <text>]"
        itemno "$n"
        [ "$from" != "$to" ] || die "from and to are the same queue"
        f=$(qf "$from"); item=$(sed -n "${n}p" "$f" 2>/dev/null); [ -n "$item" ] || die "no item $n on $(label "$from")"
        [ "$guard" = 0 ] || [ "$item" = "$want" ] || die "queue changed; run 'sitrep ls $(label "$from")'"
        t=$(without "$f" "$n" "$item") || die "queue changed; run 'sitrep ls $(label "$from")'"
        # append first, then swap the source in: a crash leaves a duplicate, never a lost item
        printf '%s\n' "$item" >> "$(qf "$to")" || { rm -f "$t"; die "could not queue on $(label "$to")"; }
        mv "$t" "$f" || { rm -f "$t"; die "could not update $(label "$from")"; }
        echo "moved to $(label "$to"): $(printf '%s' "$item" | strip)" ;;
  *) die "unknown command '$cmd'; run 'sitrep help'" ;;
esac
