{
  "description": "Keeps each session's Objective, Progress, Now and state under ~/.claude/sitrep, and marks the session ended",
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "\"$HOME/.claude/sitrep/bin/sitrep\" hook" } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "\"$HOME/.claude/sitrep/bin/sitrep\" hook" } ] }
    ],
    "PermissionRequest": [
      { "hooks": [ { "type": "command", "command": "\"$HOME/.claude/sitrep/bin/sitrep\" hook" } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "\"$HOME/.claude/sitrep/bin/sitrep\" hook" } ] }
    ],
    "SessionEnd": [
      { "hooks": [ { "type": "command", "command": "\"$HOME/.claude/sitrep/bin/sitrep\" hook", "timeout": 10 } ] }
    ]
  }
}
